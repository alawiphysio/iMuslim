<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp" /><solid android:color="#33F4EFE1" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp" />
            <gradient android:startColor="#FFB8902E" android:endColor="#FFF3D98B" android:angle="0" /></shape></clip>
    </item>
</layer-list>
