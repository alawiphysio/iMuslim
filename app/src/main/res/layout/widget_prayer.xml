<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصلاة القادمة"
                android:textColor="#FFA9BDB4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#FFD9B44A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="#FFF4EFE1"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="باقي"
                android:textColor="#FFA9BDB4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="--"
                android:textColor="#FFD9B44A"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_moon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFF4EFE1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFA9BDB4"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/w_c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
            <TextView android:id="@+id/w_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#FFA9BDB4" android:textSize="11sp" />
            <TextView android:id="@+id/w_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
            <TextView android:id="@+id/w_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#FFA9BDB4" android:textSize="11sp" />
            <TextView android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
            <TextView android:id="@+id/w_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#FFA9BDB4" android:textSize="11sp" />
            <TextView android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
            <TextView android:id="@+id/w_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#FFA9BDB4" android:textSize="11sp" />
            <TextView android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:padding="3dp">
            <TextView android:id="@+id/w_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#FFA9BDB4" android:textSize="11sp" />
            <TextView android:id="@+id/w_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
