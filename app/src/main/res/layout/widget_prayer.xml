<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- الخلفية المرسومة: سماء + نجوم + مسجد مدينتك -->
    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- الشخصية: يمشي للمسجد / يصلي -->
            <ImageView
                android:id="@+id/w_figure"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/w_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الصلاة القادمة"
                    android:textColor="#FFA9BDB4"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/w_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#88D9B44A"
                    android:shadowRadius="8"
                    android:text="الفجر"
                    android:textColor="#FFD9B44A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الأذان --:--"
                    android:textColor="#FFF4EFE1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/w_iqama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الإقامة --:--"
                    android:textColor="#FFF6DE8D"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/w_moon_img"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/w_moon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:textColor="#FFA9BDB4"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- حلقة العدّاد -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/w_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/w_ring_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="للأذان"
                        android:textColor="#FFA9BDB4"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/w_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:shadowColor="#66F6DE8D"
                        android:shadowRadius="10"
                        android:text="--"
                        android:textColor="#FFF4EFE1"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/w_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="دقيقة"
                        android:textColor="#FFD9B44A"
                        android:textSize="10sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- أوقات اليوم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/w_c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
                <TextView android:id="@+id/w_n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#FFA9BDB4" android:textSize="10sp" />
                <TextView android:id="@+id/w_t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
                <TextView android:id="@+id/w_n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#FFA9BDB4" android:textSize="10sp" />
                <TextView android:id="@+id/w_t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
                <TextView android:id="@+id/w_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#FFA9BDB4" android:textSize="10sp" />
                <TextView android:id="@+id/w_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
                <TextView android:id="@+id/w_n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#FFA9BDB4" android:textSize="10sp" />
                <TextView android:id="@+id/w_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
                <TextView android:id="@+id/w_n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#FFA9BDB4" android:textSize="10sp" />
                <TextView android:id="@+id/w_t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#FFF4EFE1" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
